function viewSec(key) {
  var sec = SEC[key], all = Store.list(sec.col), fl = FLT[key] || (FLT[key] = {});
  var items = all.filter(function (x) {
    return Object.keys(fl).every(function (k) { return !fl[k] || x[k] === fl[k]; });
  }).sort(sec.sort);
  var filtrado = Object.keys(fl).some(function (k) { return fl[k]; });

  var html = '<div class="head"><h2>' + esc(sec.nome) + '</h2><div class="row">' +
    (key === 'briefing' ? '<button class="btn" data-act="cats">Categorias</button>' : '') +

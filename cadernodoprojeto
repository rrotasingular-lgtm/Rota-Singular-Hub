    '<p class="muted">' + esc(sec.intro) + '</p>';

  if (sec.summary) {
    var sf = fieldOf(sec, sec.summary);
    html += '<div class="chips" role="group" aria-label="Resumo por ' + esc(sf.l.toLowerCase()) + '">' + optsOf(sf).map(function (o) {
      var n = all.filter(function (x) { return x[sec.summary] === o; }).length;
      return '<button class="chip" data-act="chip" data-sec="' + key + '" data-k="' + sec.summary + '" data-v="' + esc(o) + '" aria-pressed="' + (fl[sec.summary] === o) + '">' + esc(cap(o)) + ': ' + n + '</button>';
    }).join('') + '</div>';
  }

  html += '<div class="filters">' + sec.filters.map(function (k) {
    var f = fieldOf(sec, k), o = optsOf(f).slice();
    if (fl[k] && o.indexOf(fl[k]) < 0) o.push(fl[k]);
    return '<label>' + esc(f.l) + '<select data-act="filter" data-sec="' + key + '" data-k="' + k + '"><option value="">Todos</option>' +
      o.map(function (x) { return '<option value="' + esc(x) + '"' + (fl[k] === x ? ' selected' : '') + '>' + esc(cap(x)) + '</option>'; }).join('') + '</select></label>';
  }).join('') + (filtrado ? '<div><button class="btn sm" data-act="limpar" data-sec="' + key + '">Limpar filtros</button></div>' : '') + '</div>';

  if (!all.length) html += '<div class="empty">' + esc(sec.vazio) + '</div>';
  else if (!items.length) html += '<div class="empty">Nenhum registo corresponde aos filtros escolhidos.</div>';

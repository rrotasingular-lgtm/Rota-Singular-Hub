    html += '<p class="muted small">' + items.length + ' ' + plural(items.length, 'registo', 'registos') + (filtrado ? ' (de ' + all.length + ')' : '') + '</p>' +
      items.map(function (it) { return cardHtml(key, it); }).join('');
  }
  return html;
}


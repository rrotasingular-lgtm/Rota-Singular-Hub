    : '<p class="muted">Não há datas futuras por concluir no calendário.</p>') +
    '<a href="#marcos">Ver calendário</a></div>';

  html += '<div class="card"><h3>Atalhos</h3><div class="row" style="margin-top:.5rem">' +
    '<button class="btn pri" data-act="atalho" data-w="tarefa">Nova tarefa</button>' +
    '<button class="btn" data-act="atalho" data-w="resposta">Registar resposta</button>' +
    '<button class="btn" data-act="atalho" data-w="nota">Adicionar nota</button></div></div>';

  html += '<div class="card"><h3>Últimas decisões e notas</h3>' + (ultimas.length
    ? ultimas.map(function (x) {
        return '<p><b>' + esc(x.titulo) + '</b> <span class="badge ' + bc(x.estado) + '">' + esc(cap(x.estado)) + '</span>' +
          (x.data ? '<br><span class="muted small">' + esc(fmtDate(x.data)) + '</span>' : '') + '</p>';
      }).join('') + '<a href="#decisoes">Ver todas</a>'
    : '<p class="muted">Ainda não há decisões nem notas registadas.</p>') + '</div>';

  html += '<div class="card"><div class="head"><h3>Dados do projeto</h3><button class="btn sm" data-act="projeto">Editar</button></div>' +
    '<div class="kv">' +
    kv('Formação', p.formacao) + kv('Tipo de projeto', p.tipo) + kv('Organização parceira', p.organizacao) +
    kv('Interlocutora', p.interlocutora) +
    kv('Contacto', p.contacto, p.contacto ? 'tel:' + String(p.contacto).replace(/[^\d+]/g, '') : '') +
    kv('Consultora', p.consultora) +
    kv('Email da consultora', p.emailConsultora, p.emailConsultora ? 'mailto:' + p.emailConsultora : '') + '</div>' +
    '<details><summary>Descrição do desafio (indicada pela formação)</summary><p style="white-space:pre-wrap">' + esc(p.descricao) + '</p></details>' +
    '<details><summary>Âmbito geral da formação</summary>' +
    '<p class="small muted">Descreve o âmbito geral; não significa que tudo seja necessário na solução final.</p>' +
    '<p><b>Poderá incluir</b></p><ul class="plain"><li>Estruturação de base de dados</li><li>Organização e centralização da informação</li><li>Listagens e páginas de detalhe</li><li>Filtros e categorização</li><li>Criação e edição de registos</li><li>Automações simples, como notificações por email</li><li>Interface simples para consulta e gestão interna</li><li>Sistema básico de permissões e acessos, quando aplicável</li></ul>' +
    '<p><b>Não está previsto</b></p><ul class="plain"><li>Integrações complexas com ERPs ou softwares internos</li><li>Desenvolvimento com código personalizado</li><li>Integrações avançadas com APIs externas</li><li>Dashboards financeiros altamente personalizados</li><li>Lógicas de backend complexas ou sistemas proprietários</li><li>Desenvolvimento contínuo após o término do projeto</li></ul></details></div>';

  if (nuncaExportou) {
    html += '<div class="card"><b>Ainda não fez cópia de segurança.</b> <span class="muted">Os dados ficam só neste navegador. Vá a «Cópia de segurança» para exportar.</span></div>';
  }
  html += '<p class="muted small">Este caderno é privado e funciona só neste dispositivo. Não registe dados reais ou identificáveis de famílias: use apenas dados fictícios ou anónimos.</p>';
  return html;
};
function kv(l, v, href) {
  if (!v) return '';
  var val = href ? '<a href="' + esc(href) + '">' + esc(v) + '</a>' : esc(v);
  return '<div class="ln"><b>' + esc(l) + '</b><span class="v">' + val + '</span></div>';
}

VIEWS.dados = function () {
  var d = Store.data, n = countAll(d);
  return '<h2>Cópia de segurança</h2>' +
    '<div class="card"><h3>Onde ficam os dados</h3>' +
    '<p>Os registos ficam guardados <b>neste navegador, neste dispositivo</b>. Podem perder-se se limpar os dados do navegador ou o histórico do site, e <b>não aparecem</b> noutro computador, telemóvel ou navegador.</p>' +
    '<p>A exportação é uma <b>cópia de segurança manual</b>, não uma sincronização automática. Exporte regularmente e guarde o ficheiro num local seguro.</p>' +
    '<p class="small ' + (Store.ok ? 'muted' : 'late') + '">Armazenamento local: ' + (Store.ok ? 'disponível' : 'indisponível — nada está a ser guardado') + '. Registos atuais: ' + n + '.</p>' +
    '<p class="small muted">Última exportação: ' + (d.meta.ultimaExportacao ? esc(fmtStamp(d.meta.ultimaExportacao)) : 'nunca') + '.</p></div>' +
    '<div class="card"><h3>Exportar</h3><p class="muted">Descarrega todos os registos num ficheiro JSON. Nada é enviado para a internet.</p>' +
    '<button class="btn pri" data-act="exportar">Exportar dados (JSON)</button></div>' +
    '<div class="card"><h3>Importar</h3><p class="muted">Restaura uma cópia exportada antes. O ficheiro é verificado e, se estiver correto, pede confirmação antes de <b>substituir todos os registos atuais</b>.</p>' +
    '<button class="btn" data-act="importar">Importar cópia (JSON)</button></div>';
};

/* =====================================================================
   9. EXPORTAÇÃO E IMPORTAÇÃO
   ===================================================================== */
function exportar() {
  try {
    var payload = { app: 'caderno-projeto', versao: 1, exportadoEm: new Date().toISOString(), dados: Store.data };
    var blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url; a.download = 'caderno-projeto-' + today() + '.json';
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(function () { URL.revokeObjectURL(url); }, 4000);
  } catch (e) {
    toast('Não foi possível gerar o ficheiro de exportação.', true);
    return;
  }
  Store.commit(function (d) { d.meta.ultimaExportacao = new Date().toISOString(); });
  toast('Ficheiro preparado. Confirme que ficou guardado no dispositivo.');
  if (route === 'dados' || route === 'painel') render();
}

function importar(file) {
  if (!file) return;
  var rd = new FileReader();
  rd.onerror = function () { toast('Não foi possível ler o ficheiro.', true); };
  rd.onload = function () {
    var p;
    try { p = JSON.parse(String(rd.result)); } catch (e) { toast('O ficheiro não é um JSON válido. Nada foi alterado.', true); return; }
    var err = validate(p);
    if (err) { toast(err + ' Nada foi alterado.', true); return; }
    var novos = countAll(p.dados), atuais = countAll(Store.data);
    var quando = p.exportadoEm ? fmtStamp(p.exportadoEm) : 'data desconhecida';
    var msg = 'Vai SUBSTITUIR todos os registos atuais (' + atuais + ') pelos da cópia (' + novos + ', exportada em ' + quando + ').\n\nEsta ação não pode ser desfeita. Se tiver dúvidas, cancele e exporte primeiro os dados atuais.\n\nContinuar?';
    if (!window.confirm(msg)) { toast('Importação cancelada. Nada foi alterado.'); return; }
    var novo = normalize(p.dados);
    var r = Store.commit(function (d) {
      Object.keys(d).forEach(function (k) { delete d[k]; });
      Object.assign(d, novo);
    });
    if (report(r, 'Cópia importada com sucesso.')) render();
  };
  rd.readAsText(file);
}

/* =====================================================================
   10. RENDERIZAÇÃO E EVENTOS
   ===================================================================== */
var route = 'painel';

function render() {
  var h = (location.hash || '#painel').slice(1);
  route = VIEWS[h] ? h : 'painel';
  $('#nav').innerHTML = NAV.map(function (n) {
    return '<a href="#' + n[0] + '"' + (n[0] === route ? ' aria-current="page"' : '') + '>' + esc(n[1]) + '</a>';
  }).join('');
  var b = '';
  if (!Store.ok) b += '<div class="banner bad"><b>O armazenamento local não está disponível</b> (pode estar bloqueado ou em modo privado). Pode usar o caderno, mas <b>nada fica guardado</b> ao fechar ou atualizar a página. Use «Cópia de segurança» para exportar o que registar.</div>';
  if (Store.loadMsg) b += '<div class="banner">' + esc(Store.loadMsg) + '</div>';
  $('#banner').innerHTML = b;
  $('#view').innerHTML = VIEWS[route]();
  var cur = $('#nav [aria-current]');
  if (cur && cur.scrollIntoView) { try { cur.scrollIntoView({ block: 'nearest', inline: 'center' }); } catch (e) { /* ignorar */ } }
}

document.addEventListener('click', function (ev) {
  var el = ev.target.closest('[data-act]');
  if (!el || el.tagName === 'SELECT' || el.type === 'checkbox') return;
  var act = el.getAttribute('data-act'), key = el.getAttribute('data-sec'), id = el.getAttribute('data-id');
  switch (act) {
    case 'close': closeForm(); break;
    case 'novo': openItemForm(key); break;
    case 'edit': openItemForm(key, id); break;
    case 'del': deleteItem(key, id); break;
    case 'concluir':
      if (report(Store.update('tarefas', id, { estado: 'concluída' }), 'Tarefa concluída.')) render();
      break;
    case 'chip':
      var k = el.getAttribute('data-k'), v = el.getAttribute('data-v');
      FLT[key] = FLT[key] || {};
      FLT[key][k] = FLT[key][k] === v ? '' : v;
      render(); break;
    case 'limpar': FLT[key] = {}; render(); break;
    case 'cats': openCats(); break;
    case 'catAdd':
      var rows = $('#catRows');
      if (rows) { rows.insertAdjacentHTML('beforeend', catRow('', '')); var inp = rows.lastElementChild.querySelector('input'); if (inp) inp.focus(); }
      break;
    case 'catDel':
      var row = el.closest('.catrow'), i2 = row.querySelector('input');
      if (i2.getAttribute('data-old')) { i2.value = ''; row.hidden = true; } else row.remove();
      break;
    case 'projeto': openProjeto(); break;
    case 'atalho':
      var w = el.getAttribute('data-w');
      if (w === 'tarefa') openItemForm('tarefas');
      else if (w === 'resposta') openItemForm('briefing', null, { estado: 'respondida' });
      else openItemForm('decisoes');
      break;
    case 'exportar': exportar(); break;
    case 'importar': $('#fileImp').click(); break;
  }
});

document.addEventListener('change', function (ev) {
  var el = ev.target;
  if (el.id === 'fileImp') { importar(el.files && el.files[0]); el.value = ''; return; }
  var act = el.getAttribute && el.getAttribute('data-act');
  if (!act) return;
  var key = el.getAttribute('data-sec'), id = el.getAttribute('data-id');
  if (act === 'quick') {
    if (report(Store.update(SEC[key].col, id, { estado: el.value }), 'Estado atualizado.')) render();
  } else if (act === 'toggle') {
    if (report(Store.update('entrega', id, { concluido: el.checked }), el.checked ? 'Item concluído.' : 'Item reaberto.')) render();
    else render();
  } else if (act === 'filter') {
    FLT[key] = FLT[key] || {};
    FLT[key][el.getAttribute('data-k')] = el.value;
    render();
  }
});

$('#mForm').addEventListener('submit', submitForm);
document.addEventListener('keydown', function (ev) { if (ev.key === 'Escape' && !$('#modal').hidden) closeForm(); });
window.addEventListener('hashchange', function () { window.scrollTo(0, 0); render(); });

/* =====================================================================
   11. ARRANQUE
   ===================================================================== */
Store.init();
render();

})();
</script>

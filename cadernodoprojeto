<!DOCTYPE html>
<html lang="pt-PT">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<title>Caderno do projeto — Casas Saudáveis: Famílias Felizes</title>
<style>
/* ============ Base e cores ============ */
:root{
  --bg:#f4f6f8; --card:#ffffff; --txt:#1c2430; --muted:#5a6678; --line:#d9dee6;
  --acc:#1f5f7a; --acc-txt:#ffffff; --acc-soft:#e3eff4;
  --ok:#1d6b3f; --ok-bg:#e1f2e8;
  --warn:#7a5200; --warn-bg:#fbefd0;
  --info:#1f4f9a; --info-bg:#e2ebfa;
  --bad:#9a1f2b; --bad-bg:#fbe3e5;
  --neu:#46515f; --neu-bg:#e8ecf1;
  --radius:8px;
}
@media (prefers-color-scheme:dark){
  :root{
    --bg:#13171c; --card:#1b2129; --txt:#e6eaf0; --muted:#98a3b3; --line:#2d3541;
    --acc:#6cb4cf; --acc-txt:#0d1a20; --acc-soft:#1b2c35;
    --ok:#7fd1a0; --ok-bg:#183626;
    --warn:#f0c46a; --warn-bg:#3b2f12;
    --info:#8fb4f0; --info-bg:#1b2b4a;
    --bad:#f19aa2; --bad-bg:#44212a;
    --neu:#b4bfcd; --neu-bg:#2a313b;
  }
}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{-webkit-text-size-adjust:100%}
body{
  margin:0; background:var(--bg); color:var(--txt);
  font:16px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  padding-bottom:env(safe-area-inset-bottom,0);
}
body.lock{overflow:hidden}
h1,h2,h3{line-height:1.25;margin:0}
h2{font-size:1.35rem}
h3{font-size:1.05rem}
p{margin:.4rem 0}
a{color:var(--acc)}
.muted{color:var(--muted)}
.small{font-size:.875rem}
:focus-visible{outline:3px solid var(--acc);outline-offset:2px}

/* ============ Estrutura ============ */
.top{background:var(--card);border-bottom:1px solid var(--line);padding:.75rem 1rem;padding-top:calc(.75rem + env(safe-area-inset-top,0))}
.top .in{max-width:900px;margin:0 auto}
.top h1{font-size:1.05rem}
.top .sub{color:var(--muted);font-size:.85rem}
nav{position:sticky;top:0;z-index:5;background:var(--card);border-bottom:1px solid var(--line);overflow-x:auto;-webkit-overflow-scrolling:touch}
nav .in{display:flex;max-width:900px;margin:0 auto;padding:0 .5rem;white-space:nowrap}
nav a{display:block;padding:.8rem .8rem;text-decoration:none;color:var(--muted);font-size:.95rem;border-bottom:3px solid transparent}
nav a[aria-current="page"]{color:var(--acc);border-bottom-color:var(--acc);font-weight:600}
main{max-width:900px;margin:0 auto;padding:1rem;padding-left:max(1rem,env(safe-area-inset-left,0));padding-right:max(1rem,env(safe-area-inset-right,0))}
.banner{max-width:900px;margin:.75rem auto 0;padding:.75rem 1rem;border-radius:var(--radius);background:var(--warn-bg);color:var(--warn);font-size:.92rem}
.banner.bad{background:var(--bad-bg);color:var(--bad)}
.banner-wrap{padding:0 1rem}

/* ============ Componentes ============ */
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:1rem;margin:0 0 .75rem}
.head{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;justify-content:space-between;margin-bottom:.5rem}
.row{display:flex;flex-wrap:wrap;gap:.5rem}
.btn{
  font:inherit;font-size:.95rem;min-height:44px;padding:.45rem .95rem;border-radius:var(--radius);
  border:1px solid var(--line);background:var(--card);color:var(--txt);cursor:pointer;
}
.btn:hover{border-color:var(--acc)}
.btn.pri{background:var(--acc);border-color:var(--acc);color:var(--acc-txt);font-weight:600}
.btn.sm{min-height:38px;padding:.25rem .7rem;font-size:.88rem}
.btn.danger{color:var(--bad)}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:.75rem;margin-bottom:.75rem}
.stat{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:.8rem 1rem}
.stat b{display:block;font-size:1.7rem;line-height:1.2}
.stat span{color:var(--muted);font-size:.88rem}
.badge{display:inline-block;padding:.1rem .55rem;border-radius:999px;font-size:.8rem;background:var(--neu-bg);color:var(--neu);white-space:nowrap}
.badge.ok{background:var(--ok-bg);color:var(--ok)}
.badge.warn{background:var(--warn-bg);color:var(--warn)}
.badge.info{background:var(--info-bg);color:var(--info)}
.badge.bad,.badge.hi{background:var(--bad-bg);color:var(--bad)}
.badges{display:flex;flex-wrap:wrap;gap:.35rem;margin:.35rem 0}
.item{border-left:4px solid var(--line)}
.item.ok{border-left-color:var(--ok)}
.item.warn{border-left-color:var(--warn);border-left-style:dashed}
.item.info{border-left-color:var(--info)}
.item.bad{border-left-color:var(--bad)}
.item h3{word-break:break-word}
.ln{margin:.3rem 0;word-break:break-word}
.ln b{font-weight:600;color:var(--muted);font-size:.88rem;display:block}
.ln .v{white-space:pre-wrap}
.late{color:var(--bad);font-weight:600}
.actions{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;margin-top:.6rem}
.chips{display:flex;flex-wrap:wrap;gap:.4rem;margin:.5rem 0}
.chip{font:inherit;font-size:.88rem;min-height:36px;padding:.2rem .75rem;border-radius:999px;border:1px solid var(--line);background:var(--card);color:var(--txt);cursor:pointer}
.chip[aria-pressed="true"]{background:var(--acc-soft);border-color:var(--acc);color:var(--acc);font-weight:600}
.filters{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.5rem;margin:.5rem 0 .9rem;align-items:end}
.filters label{font-size:.85rem;color:var(--muted);display:block}
select,input[type=text],input[type=date],input[type=time],input[type=email],textarea{
  font:inherit;font-size:16px;width:100%;min-height:44px;padding:.45rem .6rem;border-radius:var(--radius);
  border:1px solid var(--line);background:var(--card);color:var(--txt);
}
textarea{resize:vertical;min-height:80px}
.qs{width:auto;min-height:38px;font-size:.9rem}
.empty{text-align:center;color:var(--muted);padding:1.5rem 1rem;border:1px dashed var(--line);border-radius:var(--radius)}
.kv{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:.6rem 1rem}
details{margin:.4rem 0}
summary{cursor:pointer;min-height:36px;padding:.35rem 0;font-weight:600}
ul.plain{margin:.3rem 0;padding-left:1.2rem}
.check{display:flex;gap:.75rem;align-items:flex-start}
.check input[type=checkbox]{width:24px;height:24px;margin-top:.15rem;flex:none}
.check.done .t{text-decoration:line-through;color:var(--muted)}
.progress{height:8px;border-radius:999px;background:var(--neu-bg);overflow:hidden;margin:.4rem 0 .9rem}
.progress i{display:block;height:100%;background:var(--ok)}

/* ============ Formulário (janela) ============ */
.overlay{position:fixed;inset:0;z-index:20;background:rgba(10,15,20,.55);display:flex;align-items:flex-end;justify-content:center}
.sheet{background:var(--card);color:var(--txt);width:100%;max-width:560px;max-height:92vh;max-height:92dvh;display:flex;flex-direction:column;border-radius:14px 14px 0 0}
.sheet header{padding:.9rem 1rem;border-bottom:1px solid var(--line)}
.sheet .body{padding:1rem;overflow:auto;-webkit-overflow-scrolling:touch}
.sheet footer{padding:.75rem 1rem;padding-bottom:calc(.75rem + env(safe-area-inset-bottom,0));border-top:1px solid var(--line);display:flex;gap:.5rem;justify-content:flex-end}
.fld{display:block;margin-bottom:.9rem}
.fld>span{display:block;font-size:.88rem;color:var(--muted);margin-bottom:.2rem}
.catrow{display:flex;gap:.5rem;margin-bottom:.5rem}
@media (min-width:640px){
  .overlay{align-items:center}
  .sheet{border-radius:14px}
}

.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(1rem + env(safe-area-inset-bottom,0));z-index:30;background:#1c2430;color:#fff;padding:.7rem 1rem;border-radius:var(--radius);max-width:92%;font-size:.92rem;box-shadow:0 2px 10px rgba(0,0,0,.3)}
.toast.bad{background:#9a1f2b}
@media (prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>
</head>
<body>

<div class="top"><div class="in">
  <h1>Caderno do projeto</h1>
  <div class="sub">Descodifica-te · Fledge Institute — uso pessoal e privado</div>
</div></div>
<nav aria-label="Secções"><div class="in" id="nav"></div></nav>
<div class="banner-wrap" id="banner"></div>
<main id="view"></main>

<div class="overlay" id="modal" hidden>
  <form class="sheet" id="mForm" role="dialog" aria-modal="true" aria-labelledby="mTitle">
    <header><h3 id="mTitle"></h3></header>
    <div class="body" id="mBody"></div>
    <footer>
      <button type="button" class="btn" data-act="close">Cancelar</button>
      <button type="submit" class="btn pri">Guardar</button>
    </footer>
  </form>
</div>
<input type="file" id="fileImp" accept=".json,application/json" hidden>
<div class="toast" id="toast" role="status" aria-live="polite" hidden></div>

<script>
'use strict';
(function () {

/* =====================================================================
   1. CONSTANTES E DADOS INICIAIS
   ===================================================================== */
var KEY = 'caderno-projeto:v1';
var COLS = ['briefing', 'requisitos', 'tarefas', 'decisoes', 'marcos', 'dev', 'entrega'];

var OPT = {
  briefing: ['por perguntar', 'respondida', 'requer esclarecimento'],
  prio: ['alta', 'média', 'baixa'],
  req: ['por validar', 'confirmado', 'em desenvolvimento', 'concluído', 'excluído'],
  tar: ['por fazer', 'em curso', 'bloqueada', 'concluída'],
  dec: ['proposta', 'por validar', 'confirmada'],
  marco: ['por confirmar', 'confirmado', 'concluído', 'reagendado'],
  dev: ['por iniciar', 'em curso', 'concluído', 'bloqueado'],
  teste: ['não testado', 'passou', 'falhou', 'parcial'],
  fases: ['Matchmaking e reunião de briefing', 'Planeamento', 'Desenvolvimento', 'Afinação e testes finais', 'Aprovação e entrega']
};

var CATEGORIAS = [
  'Objetivos do projeto', 'Processo de trabalho atual', 'Dados a registar', 'Acompanhamento e prioridades',
  'Utilizadores e acessos', 'Utilização da aplicação', 'Privacidade e segurança', 'Âmbito e validação'
];

var ENTREGA = [
  'Requisitos e âmbito documentados', 'Estrutura da solução documentada', 'Primeira versão funcional preparada',
  'Testes finais registados', 'Feedback da parceira documentado', 'Ajustes finais registados',
  'Instruções de utilização preparadas', 'Entrega final preparada', 'Validação final registada'
];

var DESC_OFICIAL = 'Nesta fase, será desenvolvida uma aplicação digital para apoiar técnicos nas visitas domiciliárias, permitindo registar e consultar de forma estruturada a caracterização social, familiar e habitacional dos agregados. O objetivo principal é substituir os registos em papel, centralizar a informação de cada caso e facilitar a avaliação e o acompanhamento ao longo do tempo, incluindo a classificação do nível de prioridade de intervenção. O MVP deverá focar-se na estrutura e no funcionamento da aplicação, utilizando apenas dados fictícios ou anónimos durante o desenvolvimento e os testes. As funcionalidades relacionadas com plataformas de bens ou matching de donativos não estão incluídas nesta fase. Os detalhes e requisitos serão aprofundados na primeira reunião com o parceiro.';

function defaults() {
  var t = Date.now();
  var marco = function (nome, data, hora, desc) {
    return { id: uid(), criado: t, nome: nome, data: data, hora: hora, descricao: desc, estado: 'por confirmar' };
  };
  return {
    projeto: {
      nome: 'Casas Saudáveis: Famílias Felizes',
      organizacao: 'Santa Casa da Misericórdia de Lisboa',
      formacao: 'Descodifica-te — Fledge Institute',
      tipo: 'Ferramenta interna — CRM tool',
      interlocutora: 'Ana Luísa Gomes',
      contacto: '963269959',
      consultora: 'Carla da Silva Assis',
      emailConsultora: 'carlamiguelassis@gmail.com',
      descricao: DESC_OFICIAL
    },
    meta: { ultimaExportacao: '' },
    categorias: CATEGORIAS.slice(),
    briefing: [],
    requisitos: [],
    tarefas: [{
      id: uid(), criado: t,
      titulo: 'Confirmar a data da 1.ª reunião e o convite para todos os envolvidos',
      descricao: '', fase: OPT.fases[0], prioridade: 'alta', estado: 'por fazer', dataLimite: '',
      notas: 'Indicado como próximo passo no email da formação.'
    }],
    decisoes: [],
    marcos: [
      marco('1.ª reunião de briefing', '2026-10-09', '14:40', 'Apresentação do desafio e esclarecimento de dúvidas; definição das principais necessidades e requisitos; alinhamento sobre o plano de desenvolvimento. Data sugerida pela formação.'),
      marco('2.ª reunião — validação do desenvolvimento', '2026-10-15', '12:00', 'Feedback sobre o progresso e ajustes necessários. Data sugerida pela formação.'),
      marco('3.ª reunião — apresentação da versão final', '2026-10-20', '13:00', 'Apresentação da solução final e considerações finais. Data sugerida pela formação.'),
      marco('Prazo: planeamento e arquitetura', '2026-10-25', '', 'Plano de ação, especificações e arquitetura do projeto.'),
      marco('Prazo: primeira versão funcional', '2026-11-15', '', 'Primeira versão funcional para feedback da parceira.'),
      marco('Prazo: afinação e testes finais', '2026-11-29', '', 'Refinamento do projeto e testes finais.'),
      marco('Prazo: aprovação e entrega', '2026-12-06', '', 'Aprovação final e entrega do projeto à parceira.')
    ],
    dev: [],
    entrega: ENTREGA.map(function (x) { return { id: uid(), criado: t, texto: x, concluido: false, observacoes: '' }; })
  };
}

/* =====================================================================
   2. UTILITÁRIOS
   ===================================================================== */
function $(s, r) { return (r || document).querySelector(s); }
function esc(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  });
}
function cap(s) { s = String(s || ''); return s ? s.charAt(0).toUpperCase() + s.slice(1) : ''; }
function uid() { return Date.now().toString(36) + Math.random().toString(36).slice(2, 8); }
function pad(n) { return (n < 10 ? '0' : '') + n; }
function today() { var d = new Date(); return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()); }
var MESES = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
function fmtDate(s) {
  var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(s || '');
  return m ? (+m[3]) + ' ' + MESES[+m[2] - 1] + ' ' + m[1] : (s || '');
}
function fmtStamp(iso) {
  if (!iso) return '';
  var d = new Date(iso);
  if (isNaN(d.getTime())) return '';
  return fmtDate(d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate())) + ' às ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
}
function plural(n, um, varios) { return n === 1 ? um : varios; }

/* =====================================================================
   3. VALIDAÇÃO DE COPIAS (importação e leitura do armazenamento)
   ===================================================================== */
function validate(p) {
  if (!p || typeof p !== 'object' || Array.isArray(p)) return 'O ficheiro não tem a estrutura esperada.';
  if (p.app !== 'caderno-projeto') return 'Este ficheiro não parece ser uma cópia deste caderno.';
  var x = p.dados;
  if (!x || typeof x !== 'object' || Array.isArray(x)) return 'Faltam os dados na cópia.';
  for (var i = 0; i < COLS.length; i++) {
    var c = COLS[i];
    if (!Array.isArray(x[c])) return 'Falta a lista «' + c + '» na cópia.';
    for (var j = 0; j < x[c].length; j++) {
      var it = x[c][j];
      if (!it || typeof it !== 'object' || Array.isArray(it) || typeof it.id !== 'string') return 'Há registos inválidos em «' + c + '».';
    }
  }
  if (!Array.isArray(x.categorias) || x.categorias.some(function (c) { return typeof c !== 'string'; })) return 'As categorias da cópia são inválidas.';
  if (!x.projeto || typeof x.projeto !== 'object' || Array.isArray(x.projeto)) return 'Faltam os dados do projeto na cópia.';
  return null;
}
function normalize(x) {
  var d = defaults();
  d.projeto = Object.assign(d.projeto, x.projeto);
  d.meta = Object.assign({ ultimaExportacao: '' }, x.meta && typeof x.meta === 'object' ? x.meta : {});
  d.categorias = x.categorias.slice();
  COLS.forEach(function (c) {
    d[c] = x[c].map(function (it) { return Object.assign({ criado: 0 }, it); });
  });
  return d;
}
function countAll(x) {
  return COLS.reduce(function (n, c) { return n + (x[c] ? x[c].length : 0); }, 0);
}

/* =====================================================================
   4. ARMAZENAMENTO CENTRALIZADO (único ponto de acesso a localStorage)
   commit devolve: 'ok' (guardado) | 'temp' (só em memória) | 'fail' (revertido)
   ===================================================================== */
var Store = {
  ok: true,
  data: null,
  loadMsg: '',

  init: function () {
    var raw = null;
    try { localStorage.setItem('__cp_teste', '1'); localStorage.removeItem('__cp_teste'); } catch (e) { this.ok = false; }
    if (this.ok) { try { raw = localStorage.getItem(KEY); } catch (e) { this.ok = false; } }
    if (raw) {
      try {
        var p = JSON.parse(raw);
        var err = validate(p);
        if (err) throw new Error(err);
        this.data = normalize(p.dados);
        return;
      } catch (e) {
        this.loadMsg = 'Os dados guardados neste navegador estavam ilegíveis. Foi iniciado um caderno novo; a versão ilegível ficou guardada à parte (chave «' + KEY + ':corrompido») para não se perder.';
        try { localStorage.setItem(KEY + ':corrompido', raw); } catch (e2) { /* sem espaço: nada a fazer */ }
      }
    }
    this.data = defaults();
    if (this.ok) this.persist();
  },

  persist: function () {
    if (!this.ok) return false;
    try {
      localStorage.setItem(KEY, JSON.stringify({ app: 'caderno-projeto', versao: 1, guardadoEm: new Date().toISOString(), dados: this.data }));
      return true;
    } catch (e) { return false; }
  },

  commit: function (fn) {
    var antes = JSON.stringify(this.data);
    try { fn(this.data); } catch (e) { this.data = JSON.parse(antes); return 'fail'; }
    if (this.persist()) return 'ok';
    if (!this.ok) return 'temp';
    this.data = JSON.parse(antes);   // falha ao gravar (ex.: sem espaço): reverte
    return 'fail';
  },

  list: function (c) { return this.data[c]; },
  get: function (c, id) { return this.data[c].filter(function (x) { return x.id === id; })[0]; },
  add: function (c, item) {
    item.id = uid(); item.criado = Date.now();
    return this.commit(function (d) { d[c].push(item); });
  },
  update: function (c, id, patch) {
    return this.commit(function (d) {
      var it = d[c].filter(function (x) { return x.id === id; })[0];
      if (it) Object.assign(it, patch);
    });
  },
  remove: function (c, id) {
    return this.commit(function (d) { d[c] = d[c].filter(function (x) { return x.id !== id; }); });
  }
};

/* =====================================================================
   5. DEFINIÇÃO DAS SECÇÕES (campos, filtros, ordenação)
   ===================================================================== */
var PRIO_ORD = { 'alta': 0, 'média': 1, 'baixa': 2 };
function byCriado(a, b) { return (a.criado || 0) - (b.criado || 0); }

var SEC = {
  briefing: {
    col: 'briefing', nome: 'Briefing', tit: 'pergunta', novo: 'Nova pergunta', um: 'pergunta',
    intro: 'Perguntas e respostas recolhidas nas reuniões. As respostas são escritas por si, depois de falar com a parceira.',
    vazio: 'Ainda não há perguntas. Use «Nova pergunta» para registar o que quer saber ou o que ouviu na reunião.',
    fields: [
      { k: 'pergunta', l: 'Pergunta', t: 'textarea', rows: 2, req: 1 },
      { k: 'resposta', l: 'Resposta ou apontamentos', t: 'textarea', rows: 4 },
      { k: 'categoria', l: 'Categoria', t: 'select', o: function () { return Store.data.categorias; }, badge: 1 },
      { k: 'estado', l: 'Estado', t: 'select', o: OPT.briefing, def: 'por perguntar', req: 1, badge: 1, quick: 1 },
      { k: 'data', l: 'Data do registo', t: 'date', def: today },
      { k: 'observacoes', l: 'Observações', t: 'textarea', rows: 2 }
    ],
    filters: ['categoria', 'estado'], summary: 'estado', sort: byCriado
  },
  requisitos: {
    col: 'requisitos', nome: 'Requisitos', tit: 'titulo', novo: 'Novo requisito', um: 'requisito',
    intro: 'Só é requisito confirmado o que marcar como «Confirmado». Tudo o resto são hipóteses ou questões em aberto.',
    vazio: 'Ainda não há requisitos. Use «Novo requisito» quando algo surgir no briefing.',
    fields: [
      { k: 'titulo', l: 'Título', t: 'text', req: 1 },
      { k: 'descricao', l: 'Descrição', t: 'textarea', rows: 3 },
      { k: 'origem', l: 'Origem ou contexto', t: 'text' },
      { k: 'categoria', l: 'Categoria', t: 'select', o: function () { return Store.data.categorias; }, badge: 1 },
      { k: 'prioridade', l: 'Prioridade', t: 'select', o: OPT.prio, def: 'média', req: 1, badge: 1, pre: 'Prioridade ' },
      { k: 'estado', l: 'Estado', t: 'select', o: OPT.req, def: 'por validar', req: 1, badge: 1, quick: 1 },
      { k: 'observacoes', l: 'Observações', t: 'textarea', rows: 2 }
    ],

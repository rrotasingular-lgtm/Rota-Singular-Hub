var formCfg = null;

function fieldHtml(f, val) {
  var id = 'f_' + f.k, req = f.req ? ' required' : '', inner;
  if (f.t === 'textarea') {
    inner = '<textarea id="' + id + '" name="' + f.k + '" rows="' + (f.rows || 3) + '"' + req + '>' + esc(val) + '</textarea>';
  } else if (f.t === 'select') {
    var o = optsOf(f).slice();
    if (val && o.indexOf(val) < 0) o.push(val);
    inner = '<select id="' + id + '" name="' + f.k + '"' + req + '>' + (f.req ? '' : '<option value="">—</option>') +
      o.map(function (x) { return '<option value="' + esc(x) + '"' + (x === val ? ' selected' : '') + '>' + esc(cap(x)) + '</option>'; }).join('') + '</select>';
  } else {
    inner = '<input id="' + id + '" name="' + f.k + '" type="' + (f.t || 'text') + '" value="' + esc(val) + '"' + req + '>';
  }
  return '<label class="fld" for="' + id + '"><span>' + esc(f.l) + (f.req ? ' *' : '') + '</span>' + inner + '</label>';
}

function openForm(cfg) {
  formCfg = cfg;
  $('#mTitle').textContent = cfg.titulo;
  $('#mBody').innerHTML = cfg.bodyHtml || cfg.fields.map(function (f) {
    return fieldHtml(f, cfg.values[f.k] != null ? cfg.values[f.k] : '');
  }).join('');
  $('#modal').hidden = false;
  document.body.classList.add('lock');
  if (window.matchMedia && matchMedia('(pointer:fine)').matches) {
    var first = $('#mBody input,#mBody textarea,#mBody select');
    if (first) first.focus();
  }
}
function closeForm() {
  $('#modal').hidden = true;
  document.body.classList.remove('lock');
  formCfg = null;
}

function submitForm(ev) {
  ev.preventDefault();
  if (!formCfg) return;
  var vals;
  if (formCfg.collect) {
    vals = formCfg.collect();
  } else {
    var fd = new FormData($('#mForm'));
    vals = {};
    for (var i = 0; i < formCfg.fields.length; i++) {
      var f = formCfg.fields[i], v = fd.get(f.k);
      v = v == null ? '' : String(v).trim();
      if (f.req && !v) { toast('Preencha o campo «' + f.l + '».', true); return; }
      vals[f.k] = v;
    }
  }
  if (formCfg.onSave(vals)) closeForm();
}

function openItemForm(key, id, pre) {
  var sec = SEC[key], ex = id ? Store.get(sec.col, id) : null;
  if (id && !ex) { toast('Registo não encontrado.', true); return; }
  var vals = {};
  sec.fields.forEach(function (f) {
    var v;
    if (ex) v = ex[f.k];
    else if (pre && pre[f.k] != null) v = pre[f.k];
    else v = typeof f.def === 'function' ? f.def() : f.def;
    vals[f.k] = v == null ? '' : v;
  });
  openForm({
    titulo: ex ? 'Editar ' + sec.um : sec.novo, fields: sec.fields, values: vals,
    onSave: function (v) {
      var r = ex ? Store.update(sec.col, id, v) : Store.add(sec.col, Object.assign({}, sec.extra || {}, v));
      var ok = report(r, ex ? 'Alterações guardadas.' : 'Registo criado.');
      if (ok) render();
      return ok;
    }
  });
}

function deleteItem(key, id) {
  var sec = SEC[key], it = Store.get(sec.col, id);
  if (!it) return;
  if (!window.confirm('Eliminar «' + (it[sec.tit] || 'este registo') + '»? Esta ação não pode ser desfeita.')) return;
  if (report(Store.remove(sec.col, id), 'Registo eliminado.')) render();
}

/* ---- Gestão das categorias ---- */
function catRow(old, name) {
  return '<div class="catrow"><input type="text" value="' + esc(name) + '" data-old="' + esc(old) + '" aria-label="Nome da categoria">' +
    '<button type="button" class="btn sm danger" data-act="catDel">Remover</button></div>';
}
function openCats() {
  openForm({
    titulo: 'Categorias',
    bodyHtml: '<p class="muted small">Usadas no Briefing e nos Requisitos. Ao mudar o nome, os registos existentes acompanham a alteração. Não é possível remover uma categoria em uso.</p>' +
      '<div id="catRows">' + Store.data.categorias.map(function (c) { return catRow(c, c); }).join('') + '</div>' +
      '<button type="button" class="btn sm" data-act="catAdd">Adicionar categoria</button>',
    collect: function () {
      return Array.prototype.map.call(document.querySelectorAll('#catRows input'), function (i) {
        return { old: i.getAttribute('data-old'), name: i.value.trim() };
      });
    },
    onSave: function (rows) {
      var names = [], map = {}, i, r;
      for (i = 0; i < rows.length; i++) {
        r = rows[i];
        if (!r.name) {
          if (r.old) {
            var emUso = Store.data.briefing.concat(Store.data.requisitos).some(function (x) { return x.categoria === r.old; });
            if (emUso) { toast('A categoria «' + r.old + '» está em uso e não pode ser removida.', true); return false; }
          }
          continue;
        }
        if (names.indexOf(r.name) >= 0) { toast('Há categorias repetidas: «' + r.name + '».', true); return false; }
        names.push(r.name);
        if (r.old && r.old !== r.name) map[r.old] = r.name;
      }
      var res = Store.commit(function (d) {
        d.categorias = names;
        ['briefing', 'requisitos'].forEach(function (c) {
          d[c].forEach(function (x) { if (map[x.categoria]) x.categoria = map[x.categoria]; });
        });
      });
      var ok = report(res, 'Categorias guardadas.');
      if (ok) render();
      return ok;
    }
  });
}


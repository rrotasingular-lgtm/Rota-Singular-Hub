  return ka < kb ? -1 : ka > kb ? 1 : byCriado(a, b);
}
function fieldOf(sec, k) { return sec.fields.filter(function (f) { return f.k === k; })[0]; }
function optsOf(f) { return typeof f.o === 'function' ? f.o() : f.o; }


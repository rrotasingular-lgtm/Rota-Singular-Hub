var toastTimer = null;
function toast(msg, bad) {
  var t = $('#toast');
  t.textContent = msg; t.className = 'toast' + (bad ? ' bad' : ''); t.hidden = false;
  clearTimeout(toastTimer);
  toastTimer = setTimeout(function () { t.hidden = true; }, bad ? 7000 : 3500);
}
// Interpreta o resultado de uma gravação. Devolve true se a alteração ficou aplicada.
function report(r, msgOk) {
  if (r === 'ok') { toast(msgOk); return true; }
  if (r === 'temp') { toast('Alteração feita só nesta sessão. NÃO foi guardada: o armazenamento local não está disponível.', true); return true; }
  toast('Não foi possível guardar (o armazenamento pode estar cheio). Nada foi alterado.', true);
  return false;
}

